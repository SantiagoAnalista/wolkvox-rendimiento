// Informe de gestión de asesores — Wolkvox
//
// Un solo Jenkinsfile cubre los cuatro modos. Sin fechas, cada corrida procesa
// el último periodo YA CERRADO según PERIODO, así que el cron no lleva fechas
// cableadas: en agosto el job mensual saca julio solo.
//
// Para programarlo, crear un job por modo apuntando a este mismo Jenkinsfile:
//
//    mensual   PERIODO=mes                 H 6 1 * *     (día 1 de cada mes)
//    semanal   PERIODO=semana              H 6 * * 1     (todos los lunes)
//    diario    PERIODO=dia                 H 6 * * 2-7   (procesa el día anterior)
//    intradía  PERIODO=dia, HOY=true       10,40 8,9 * * 1-6
//                                          10 12,14,16,18 * * 1-6
//
// El job diario corre de martes a domingo a propósito: el lunes procesaría el
// domingo, que no es día operativo.

pipeline {
    agent any

    parameters {
        choice(name: 'PERIODO', choices: ['mes', 'semana', 'dia'],
               description: 'Agrupación del informe: se genera un Excel por periodo.')
        booleanParam(name: 'HOY', defaultValue: false,
               description: 'Jornada en curso, hasta la hora actual. Es el modo de las corridas intradía (requiere PERIODO=dia).')
        string(name: 'DESDE', defaultValue: '',
               description: 'YYYY-MM-DD. Vacío = último periodo cerrado (lo normal en corridas programadas).')
        string(name: 'HASTA', defaultValue: '',
               description: 'YYYY-MM-DD. Vacío = hasta hoy. Solo aplica si DESDE tiene valor.')
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '60'))
        disableConcurrentBuilds()   // no basta: ver el lock del token más abajo
    }

    environment {
        WOLKVOX_TOKEN  = credentials('wolkvox-token-prod')
        WOLKVOX_SERVER = '0010'
        PYTHONIOENCODING = 'utf-8'   // los nombres de agente llevan tildes y ñ

        // Carpeta compartida desde la que la operación abre el tablero. Ahí
        // viven tablero.html y su almacén, para que el job diario y el
        // semanal acumulen en el MISMO histórico: el workspace de Jenkins no
        // sirve, cada job tiene el suyo.
        // La cuenta del servicio de Jenkins necesita escritura sobre la ruta.
        RUTA_TABLERO = '\\\\servidor\\operacion\\rendimiento'
    }

    stages {
        stage('Preparar entorno') {
            steps {
                bat '''
                    python -m venv .venv
                    .venv\\Scripts\\python -m pip install --quiet --upgrade pip
                    .venv\\Scripts\\python -m pip install --quiet -r requirements.txt
                '''
            }
        }

        stage('Pruebas') {
            steps {
                // No consumen API: si algo se rompió, mejor saberlo antes de
                // gastar tokens y de publicar cifras equivocadas.
                bat '.venv\\Scripts\\python -m pytest -q'
            }
        }

        stage('Generar informe') {
            steps {
                // El token de Wolkvox no admite consumos en paralelo, y
                // disableConcurrentBuilds() solo protege dentro de un job. Con
                // ocho corridas intradía más la semanal del lunes, dos jobs
                // pisándose deja de ser hipotético: lo que hay que bloquear es
                // el token, no el job.
                // Requiere el plugin 'lockable-resources' y declarar el recurso
                // 'wolkvox-token' en Manage Jenkins -> Lockable Resources.
                lock(resource: 'wolkvox-token') {
                    script {
                        def args = "--analisis --periodo ${params.PERIODO}"
                        if (params.HOY) {
                            args += " --hoy"
                        } else if (params.DESDE?.trim()) {
                            args += " --desde ${params.DESDE.trim()}"
                            if (params.HASTA?.trim()) { args += " --hasta ${params.HASTA.trim()}" }
                        }
                        bat ".venv\\Scripts\\python main.py ${args}"
                    }
                }
            }
        }

        stage('Publicar') {
            steps {
                // El .xlsx es el entregable auditable. El tablero NO se archiva
                // en Jenkins a propósito: Jenkins sirve lo archivado con una CSP
                // que bloquea el CSS y el JS embebidos y la página saldría en
                // blanco. main.py ya lo escribió directamente en RUTA_TABLERO.
                archiveArtifacts artifacts: 'src/output/*.xlsx',
                                 fingerprint: true, onlyIfSuccessful: true

                // El Excel sí se copia: el tablero enlaza a él por nombre.
                bat 'copy /Y src\\output\\*.xlsx "%RUTA_TABLERO%\\"'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'logs/*.log', allowEmptyArchive: true
        }
        failure {
            emailext(
                subject: "Wolkvox: falló el informe de gestión (${params.PERIODO}) — build #${env.BUILD_NUMBER}",
                body: """La corrida falló. Revisar el log del build: ${env.BUILD_URL}console

Causas frecuentes:
  - Token vencido o rotado en wolkvox Manager
  - La API no responde (wv${env.WOLKVOX_SERVER}.wolkvox.com sin respuesta)
  - Falta cargar el cronograma del mes en src/data/Horarios *.xlsx
""",
                to: 'operaciones@empresa.com')
        }
    }
}
