# Copiar este archivo como ".env" y completar los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# --- Conexión a Wolkvox ---
WOLKVOX_SERVER=0000
WOLKVOX_TOKEN=REEMPLAZAR
WOLKVOX_TIMEOUT_SEG=90
WOLKVOX_REINTENTOS=3

# --- Backup (CSV de lo extraído) ---
RUTA_BACKUP=src/data
DIAS_BACKUP=3

# --- Reporte ---
# En producción, RUTA_SALIDA apunta directamente a la carpeta compartida: el
# programa publica donde corresponde y el orquestador (Jenkins, Programador de
# tareas o una persona) no tiene que copiar nada después.
#   RUTA_SALIDA=\\servidor\operacion\rendimiento
RUTA_SALIDA=src/output

# --- Maestras diarias ---
# Cada corrida intradía escribe un Excel nuevo con la hora del corte, para que
# nunca haya que sobrescribir uno que alguien tenga abierto. Estos dos valores
# gobiernan la limpieza que corre en cada ejecución:
#   DIAS_EXCEL           días de maestras diarias que se conservan (hoy incluido)
#   HORA_CIERRE_JORNADA  a partir de esta hora la jornada se da por cerrada y
#                        sus cortes se consolidan en un solo archivo
DIAS_EXCEL=3
HORA_CIERRE_JORNADA=18

# --- Publicación en la carpeta de la operación ---
# Dónde se dejan el Excel y el tablero para que los abra coordinación.
# Admite {anio} y {mes}; {mes} se resuelve como "08. Agosto", que es la
# convención que ya usa la carpeta. Con la ruta escrita a mano, el 1 de
# septiembre seguiría publicando en agosto sin que nadie lo notara.
# Vacío = no se publica (lo normal en desarrollo).
#   RUTA_PUBLICACION=\\nassoporte\credintegral\CARTERA\{anio}\{mes}\Infomes de Gestion
RUTA_PUBLICACION=

# --- Tablero HTML ---
# Dónde se escriben tablero.html, su almacén (tablero/*.json) y el candado que
# impide dos corridas simultáneas. Vacío = junto al Excel, que sirve para
# desarrollo. En producción hay que apuntarlo a la carpeta compartida
# (p. ej. \\servidor\operacion\rendimiento): el tablero acumula el histórico de
# todos los periodos y las corridas diaria, semanal e intradía tienen que
# escribir en el mismo sitio para compartirlo y para verse entre ellas.
RUTA_TABLERO=
