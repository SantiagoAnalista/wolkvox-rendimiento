# Copiar este archivo como ".env" y completar los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# --- Conexión a Wolkvox ---
WOLKVOX_SERVER=0000
WOLKVOX_TOKEN=REEMPLAZAR
WOLKVOX_TIMEOUT_SEG=90
WOLKVOX_REINTENTOS=3

# --- Extracción ---
BLOQUE_HORAS=6
ZONA_HORARIA=America/Bogota

# --- Backup (CSV de lo extraído) ---
RUTA_BACKUP=src/data
DIAS_BACKUP=3

# --- Reporte ---
RUTA_SALIDA=src/output
RUTA_COMPARTIDA=
JORNADA_INICIO=6
JORNADA_FIN=21

# --- Tablero HTML ---
# Dónde se escriben tablero.html y su almacén (tablero/*.json).
# Vacío = junto al Excel, que sirve para desarrollo. En producción hay que
# apuntarlo a la carpeta compartida (p. ej. \\servidor\operacion\rendimiento):
# el tablero es un archivo único que acumula el histórico y los jobs diario y
# semanal deben escribir en el mismo sitio.
RUTA_TABLERO=
